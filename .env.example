# Ship & Commit — environment variables
# Copy to `.env.local` for local development. On Railway, set these as service variables.
# (Variable names starting with CTS_ are legacy config keys and intentionally unchanged.)

# ─── Frontend (NEXT_PUBLIC_*) — inlined at BUILD time ──────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Optional: browser RPC override. Leave EMPTY to use the built-in same-origin /api/rpc proxy
# (keeps your server RPC key private and avoids the public RPC's browser throttling).
NEXT_PUBLIC_SOLANA_RPC_URL=

# Show the $SHIP contract address pill in the nav
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=

# Public site origin (used for OG/Twitter image URLs). Falls back to APP_ORIGIN / RAILWAY_PUBLIC_DOMAIN.
NEXT_PUBLIC_SITE_URL=

# Optional: official X profile link. Defaults to the legacy handle until the new one exists.
NEXT_PUBLIC_X_URL=


# ─── Core (required in production) ─────────────────────────────────────────────────
# Postgres. On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Allowed browser origins for state-changing API calls (comma-separated). The origin the visitor is on
# (same host) is always accepted too, so a Railway domain + a custom domain both work.
APP_ORIGIN=https://your-app.up.railway.app

# Dedicated Solana RPC (Helius/Triton/QuickNode). REQUIRED for launches.
SOLANA_RPC_URL=
SOLANA_COMMITMENT=confirmed

# Comma-separated admin wallet pubkeys (admin login + audit-log access)
ADMIN_WALLET_PUBKEYS=

# Encrypts escrow secret keys at rest. Never change once funds exist.
ESCROW_DB_SECRET=

# Shared secret for the built-in scheduler / cron endpoints (any long random string)
CRON_SECRET=

# Signs image-upload URLs (defaults to ESCROW_DB_SECRET if unset)
ASSET_SIGNING_SECRET=


# ─── Launchpad (Privy-managed wallets + pump.fun) ──────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WEBHOOK_SIGNING_SECRET=

# Optional: sponsors fees for escrow transfers / pump.fun fee claims
ESCROW_FEE_PAYER_SECRET_KEY=

# true = anyone can launch. false = only wallets in CTS_CREATOR_WALLET_PUBKEYS / ADMIN_WALLET_PUBKEYS
CTS_PUBLIC_LAUNCHES=true
CTS_CREATOR_WALLET_PUBKEYS=

# Emergency kill switch: set to 1 to reject all new launches immediately
CTS_LAUNCHES_PAUSED=

# Text stamped into every launched token's on-chain description
LAUNCH_ATTRIBUTION=Launched with Ship & Commit


# ─── Rewards / voting ──────────────────────────────────────────────────────────────
REWARD_APPROVAL_THRESHOLD=20
REWARD_APPROVAL_THRESHOLD_USD=20
REWARD_CLAIM_DELAY_SECONDS=
REWARD_VOTE_CUTOFF_SECONDS=

CTS_SHIP_TOKEN_MINT=
CTS_SHIP_BUYBACK_TREASURY_PUBKEY=

CTS_ENABLE_REWARD_PAYOUTS=1
CTS_ENABLE_FAILURE_DISTRIBUTION_PAYOUTS=1
CTS_ENABLE_VOTE_REWARD_PAYOUTS=true
CTS_ENABLE_VOTE_REWARD_DISTRIBUTIONS=true
CTS_VOTE_REWARD_MODE=fixed
CTS_VOTE_REWARD_PER_VOTE_UI_AMOUNT=
CTS_VOTE_REWARD_POOL_UI_AMOUNT=
CTS_VOTE_REWARD_FAUCET_OWNER_PUBKEY=
CTS_VOTE_REWARD_FAUCET_OWNER_SECRET_KEY=


# ─── Utilities ─────────────────────────────────────────────────────────────────────
# Market-cap milestones (auto-resolved by the scheduler)
CTS_ENABLE_MARKETCAP_MILESTONES=1
CTS_MC_MIN_LIQUIDITY_USD=10000
CTS_MC_MIN_MINUTES_ABOVE=15
CTS_MC_MIN_SAMPLES=10
CTS_MC_MAX_GAP_SECONDS=120

# ASD (automated sell-down) live swaps
CTS_ASD_ENABLE_SWAPS=1

# Jupiter (quote/swap/price). Default is the keyless lite-api tier.
JUPITER_API_BASE_URL=
JUPITER_API_KEY=
JUPITER_PRICE_CACHE_TTL_SECONDS=60
JUPITER_PRICE_STALE_TTL_SECONDS=


# ─── Ops (optional) ────────────────────────────────────────────────────────────────
PG_POOL_MAX=15
PG_POOL_CONNECTION_TIMEOUT_MS=
PG_POOL_IDLE_TIMEOUT_MS=
# Force TLS on/off for Postgres (auto: off for *.railway.internal / localhost, on otherwise)
PG_SSL=
# Number of reverse proxies in front of the app (for client-IP rate limiting)
TRUSTED_PROXY_HOPS=1
# Disable the in-process scheduler (e.g. when running a separate cron service)
DISABLE_SCHEDULER=
AUDIT_WEBHOOK_URL=

# Local dev only: use in-memory mock data instead of Postgres. Forbidden in production.
CTS_MOCK_MODE=
