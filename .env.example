# Ship & Commit — environment variables
# Copy to `.env.local` for local development. On Railway, set these as service variables on the app service.
# Variable names starting with CTS_ are legacy config keys from the project's former name. They are intentionally
# unchanged — do not rename them. Lines that start with "# NAME=" are optional variables the code also reads.

# ─── Frontend (NEXT_PUBLIC_*) — inlined at BUILD time (changing one requires a rebuild) ────────
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Optional: browser RPC override. Leave EMPTY to use the built-in same-origin /api/rpc proxy
# (keeps your server RPC key private and avoids the public RPC's browser throttling).
NEXT_PUBLIC_SOLANA_RPC_URL=

# $SHIP contract address pill in the nav. Intentionally blank until the token exists; the pill is hidden while empty.
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=
# NEXT_PUBLIC_TOKEN_SYMBOL=
# NEXT_PUBLIC_TOKEN_NAME=

# Public site origin (canonical/OG URLs). Falls back to the first APP_ORIGIN, then RAILWAY_PUBLIC_DOMAIN.
# Leave blank until the custom domain is attached.
NEXT_PUBLIC_SITE_URL=

# Official X profile URL. Intentionally blank until the handle exists; the X buttons are hidden while empty.
NEXT_PUBLIC_X_URL=


# ─── Core (required in production) ─────────────────────────────────────────────────
# Postgres. On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}. Tables are created automatically at runtime.
# Local dev: leave empty to run on in-memory mock data.
DATABASE_URL=

# Allowed browser origins for state-changing/admin API calls (comma-separated). The origin the visitor is on
# (same host) is always accepted too, so a Railway domain + a custom domain both work.
APP_ORIGIN=https://your-app.up.railway.app

# Dedicated Solana RPC (Helius/Triton/QuickNode). REQUIRED for launches; falls back to the rate-limited public RPC.
SOLANA_RPC_URL=
SOLANA_COMMITMENT=confirmed

# Comma-separated admin wallet pubkeys (wallet-signed admin login, audit logs, admin actions)
ADMIN_WALLET_PUBKEYS=

# Encrypts raw escrow secret keys at rest (legacy/dev-fallback escrows). Never change once funds exist.
ESCROW_DB_SECRET=

# Shared secret for the built-in scheduler / cron endpoints (sent as `x-cron-secret`). Scheduler is OFF without it.
CRON_SECRET=

# Signs image-upload URLs (falls back to ESCROW_DB_SECRET, then PRIVY_APP_SECRET)
ASSET_SIGNING_SECRET=


# ─── Launchpad (Privy-managed wallets + pump.fun) ──────────────────────────────────
# Required in production: every escrow, launch wallet and ASD vault is a Privy server wallet.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Verifies webhooks sent to /api/webhooks/privy
PRIVY_WEBHOOK_SIGNING_SECRET=
# Optional: Privy authorization key(s) for signed wallet requests (comma-separated list allowed)
# PRIVY_AUTHORIZATION_PRIVATE_KEYS=

# Funded fee-payer key (base58). Required for pump.fun fee claims, escrow sweeps, launch-wallet refunds
# and sponsored escrow transfers. Keep it topped up with SOL.
ESCROW_FEE_PAYER_SECRET_KEY=

# true (default) = anyone can launch. false = only wallets in CTS_CREATOR_WALLET_PUBKEYS / ADMIN_WALLET_PUBKEYS
CTS_PUBLIC_LAUNCHES=true
CTS_CREATOR_WALLET_PUBKEYS=

# Emergency kill switch: set to 1 to reject all new Auto-Lock launches immediately (Manual Lock is not affected)
CTS_LAUNCHES_PAUSED=

# Text stamped into every launched token's on-chain description
LAUNCH_ATTRIBUTION=Launched with Ship & Commit

# Optional: lamports left in the wallet after a creator-fee sweep (default 25000)
# CTS_CREATOR_FEE_SWEEP_KEEP_LAMPORTS=


# ─── Rewards / voting ──────────────────────────────────────────────────────────────
# Minimum approving wallets for a milestone to pass (also needs approvals > rejections). Code default: 15.
REWARD_APPROVAL_THRESHOLD=20
# Not read by the code (the minimum holding value per voter is fixed at $20). Kept for compatibility.
REWARD_APPROVAL_THRESHOLD_USD=20
# Delay between completion and claimable, in seconds (default 172800 = 48h; 0 = claimable as soon as approved)
REWARD_CLAIM_DELAY_SECONDS=
# Voting window length, in seconds (default 86400 = 24h, from the due date or the early-review start)
REWARD_VOTE_CUTOFF_SECONDS=
# Optional: grace after the due date before an uncompleted milestone fails (default 86400 = 24h)
# REWARD_DELIVERY_GRACE_SECONDS=

# $SHIP mint. Intentionally blank until the new token exists; while empty the $SHIP voting multiplier and
# per-vote $SHIP rewards are inactive.
CTS_SHIP_TOKEN_MINT=
# Receives 45% of forfeited milestone escrow (required for failure distributions)
CTS_SHIP_BUYBACK_TREASURY_PUBKEY=

# Payout switches (set to 0/false to stop the corresponding transfers)
CTS_ENABLE_REWARD_PAYOUTS=1
CTS_ENABLE_FAILURE_DISTRIBUTION_PAYOUTS=1
CTS_ENABLE_VOTE_REWARD_PAYOUTS=true
CTS_ENABLE_VOTE_REWARD_DISTRIBUTIONS=true
# fixed = CTS_VOTE_REWARD_PER_VOTE_UI_AMOUNT $SHIP per vote (needs a value > 0);
# pool = CTS_VOTE_REWARD_POOL_UI_AMOUNT split among a milestone's voters (admin-created distribution)
CTS_VOTE_REWARD_MODE=fixed
CTS_VOTE_REWARD_PER_VOTE_UI_AMOUNT=
CTS_VOTE_REWARD_POOL_UI_AMOUNT=
# Vote-reward treasury/faucet: receives 5% of forfeits and pays $SHIP vote rewards.
# Owner pubkey is required for failure distributions; signer = secret key OR a Privy wallet id.
CTS_VOTE_REWARD_FAUCET_OWNER_PUBKEY=
CTS_VOTE_REWARD_FAUCET_OWNER_SECRET_KEY=
# CTS_VOTE_REWARD_FAUCET_PRIVY_WALLET_ID=
# CTS_VOTE_REWARD_MAX_POOL_UI_AMOUNT=
# CTS_VOTE_REWARD_CLAIM_TTL_SECONDS=        # default 300

# Optional: participation-streak weighting of the voter share of forfeits (0.5x–2x)
# CTS_ENABLE_PARTICIPATION_WEIGHTED_FAILURE_PAYOUTS=
# CTS_PARTICIPATION_WINDOW_MILESTONES=      # default 20
# CTS_STREAKS_GRACE_MISSES=                 # default 2
# Testing only: any non-zero holder may vote (skips the $20 minimum / price checks). Never in production.
# CTS_CANARY_REWARD_VOTING=


# ─── Utilities ─────────────────────────────────────────────────────────────────────
# Market-cap milestones (auto-resolved by the scheduler every minute)
CTS_ENABLE_MARKETCAP_MILESTONES=1
# Liquidity floor for counted samples (code default 50000)
CTS_MC_MIN_LIQUIDITY_USD=10000
CTS_MC_MIN_MINUTES_ABOVE=15
CTS_MC_MIN_SAMPLES=10
CTS_MC_MAX_GAP_SECONDS=120
# CTS_MC_MIN_VOLUME_H1_USD=                 # default 0
# CTS_MC_LOOKBACK_SECONDS=                  # default 1 year

# ASD (daily capped sell-down of a creator-funded token vault via Jupiter; API-only, every 15 min)
# (CTS_ASD_ENABLE_TRANSFERS is read as a legacy alias)
CTS_ASD_ENABLE_SWAPS=1
# CTS_ASD_DEFAULT_DESTINATION_PUBKEY=

# Transparent Bundler (declared team wallets)
# CTS_TB_NONCE_TTL_SECONDS=                 # default 900
# CTS_TB_ON_DEMAND_MAX_AGE_SECONDS=         # default 21600

# Jupiter (quote/swap/price). Empty = keyless https://lite-api.jup.ag tier.
# Keyed tier: JUPITER_API_BASE_URL=https://api.jup.ag plus JUPITER_API_KEY.
JUPITER_API_BASE_URL=
JUPITER_API_KEY=
JUPITER_PRICE_CACHE_TTL_SECONDS=60
JUPITER_PRICE_STALE_TTL_SECONDS=
# JUPITER_TIMEOUT_MS=                       # default 8000


# ─── Ops (optional) ────────────────────────────────────────────────────────────────
PG_POOL_MAX=15
PG_POOL_CONNECTION_TIMEOUT_MS=
PG_POOL_IDLE_TIMEOUT_MS=
# Force TLS on/off for Postgres (auto: off for *.railway.internal / localhost, on otherwise)
PG_SSL=
# Reverse proxies in front of the app, for client-IP rate limiting. Railway = 2 (verified in production).
TRUSTED_PROXY_HOPS=2
# Disable the in-process scheduler (e.g. when running a separate cron service)
DISABLE_SCHEDULER=
# Local dev only: run the scheduler outside production (also needs CRON_SECRET)
# ENABLE_SCHEDULER=1
# Receives high-signal audit events (*_error, *_denied, admin_*) as JSON POSTs
AUDIT_WEBHOOK_URL=

# Local dev only: use in-memory mock data instead of Postgres. Refused in production.
CTS_MOCK_MODE=
# PUMP_LOOKUP_TABLE=Hyif6eWb8x88RVrvjPfabsgRYnwkVnyByEXTVTXbUcyP  (pump.fun address lookup table for create+dev-buy in one tx; "off" = always split create/dev buy)
